{
  "name": "@djarin/next-inspect",
  "version": "0.1.1",
  "description": "Zero-code, pluggable request/console log inspector for Next.js. Captures API calls, server-side fetches and console output with file:line initiators — no per-call code needed.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "next",
    "nextjs",
    "logs",
    "inspector",
    "terminal",
    "debugging",
    "middleware",
    "logger",
    "nextjs logger"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./components": "./src/components/index.tsx",
    "./inspector-theme.css": "./src/components/inspector-theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^30.1.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
