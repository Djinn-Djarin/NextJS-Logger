{
  "name": "nextjs-log-inspector",
  "version": "0.1.0",
  "description": "Zero-code, pluggable request/console log inspector for Next.js. Captures API calls, server-side fetches and console output with file:line initiators — no per-call code needed.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "next",
    "nextjs",
    "logs",
    "inspector",
    "terminal",
    "debugging",
    "middleware"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./components": "./src/components/index.tsx",
    "./theme.css": "./src/components/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}